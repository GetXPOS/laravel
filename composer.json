{
    "name": "getxpos/laravel",
    "description": "Laravel SDK for XPOS — instant public URLs with token auth, reserved subdomains, and custom domains",
    "keywords": [
        "laravel",
        "tunnel",
        "xpos",
        "development",
        "localhost",
        "public-url",
        "share",
        "ngrok",
        "ssh"
    ],
    "homepage": "https://xpos.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "XPOS",
            "email": "info@xpos.dev",
            "homepage": "https://xpos.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "GetXPOS\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GetXPOS\\Laravel\\XposServiceProvider"
            ],
            "aliases": {
                "Xpos": "GetXPOS\\Laravel\\Facades\\Xpos"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
